{
  "name": "dsh-obsidian",
  "version": "0.1.8",
  "description": "Embed DeepSeek Harness Web UI in Obsidian, one isolated workspace per vault.",
  "main": "main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/main.ts --bundle --format=cjs --platform=node --external:obsidian --outfile=main.js",
    "bundle": "esbuild src/main.ts --bundle --format=cjs --platform=node --external:obsidian --outfile=main.js"
  },
  "keywords": [
    "obsidian",
    "deepseek",
    "dsh",
    "ai"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.7.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
